TZ=Australia/Sydney
JELLYLOOK_PORT=3045
RETENTION_DAYS=60
# Hard ceiling: nothing survives past this, not even titles you saved. Keeps a
# long-running instance from growing without bound. 365 = one year.
MAX_RETENTION_DAYS=365
RECS_PER_SCAN=60
PER_PAGE=20
LOG_LEVEL=INFO
# Titles the prompt may spend on exclusions (hidden, watched, already offered).
# Lower it if you run a local model with a small context window.
EXCLUDE_BUDGET=300

HISTORY_SOURCE=jellystat

JELLYSTAT_URL=http://192.168.1.5:3015
JELLYSTAT_API_KEY=
JELLYFIN_URL=http://192.168.1.5:8096
JELLYFIN_API_KEY=

TAUTULLI_URL=http://192.168.1.5:8181
TAUTULLI_API_KEY=

SEERR_URL=http://192.168.1.5:5055
SEERR_API_KEY=

LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5
LLM_TEMPERATURE=0.7

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GOOGLE_API_KEY=
OPENWEBUI_BASE_URL=http://192.168.1.6:8080
OPENWEBUI_API_KEY=
OLLAMA_BASE_URL=http://192.168.1.6:11434

TMDB_API_KEY=
OMDB_API_KEY=
# Country code for "where to watch" (ISO 3166-1): AU, US, GB, DE, CA...
TMDB_REGION=AU
